.ledger-settings-page .page-content {
  padding-bottom: calc(24px + 82rpx);
}

.settings-card {
  padding: 34rpx;
}

.empty-card {
  display: flex;
  min-height: 360rpx;
  align-items: center;
  justify-content: center;
}

.loading-line {
  width: 72%;
  height: 24rpx;
  margin-top: 24rpx;
  border-radius: 999rpx;
  background: #fff0ea;
}

.loading-line:first-child {
  margin-top: 0;
}

.loading-line.wide {
  width: 92%;
}

.loading-line.short {
  width: 46%;
}

.ledger-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.ledger-card {
  min-height: 214rpx;
  padding: 30rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(240, 68, 47, 0.08);
  background: rgba(255, 255, 255, 0.94);
}

.ledger-name {
  overflow: hidden;
  color: #312522;
  font-size: 32rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ledger-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.ledger-tag {
  padding: 7rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.2;
}

.type-tag.personal {
  color: #8a5a30;
  background: #fff1df;
}

.type-tag.shared {
  color: #2f7163;
  background: #e9f6f2;
}

.role-tag.owner {
  color: #b24332;
  background: #ffe9e4;
}

.role-tag.member {
  color: #5f6f7d;
  background: #eef3f6;
}

.role-tag.visitor {
  color: #7a6a90;
  background: #f1edf7;
}

.ledger-remark {
  margin-top: 18rpx;
  color: #6f5d56;
  font-size: 24rpx;
  line-height: 1.6;
}

.ledger-members {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 22rpx;
}

.member-stack {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  min-height: 52rpx;
  padding-left: 4rpx;
}

.member-avatar {
  display: block;
  flex: 0 0 52rpx;
  width: 52rpx;
  height: 52rpx;
  margin-left: -16rpx;
  box-sizing: border-box;
  border: 3rpx solid #fffdfb;
  border-radius: 50%;
  background: #fff0ea;
}

.member-avatar:first-child {
  margin-left: 0;
}

.member-avatar-fallback {
  margin-left: 0;
  padding: 7rpx;
}

.member-summary {
  color: #9a8278;
  font-size: 22rpx;
  font-weight: 700;
}

.ledger-card-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f5e9e3;
}

.ledger-action {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-height: 68rpx;
  border: 2rpx solid #f3dfd8;
  border-radius: 18rpx;
  background: #fffdfb;
  color: #825f54;
  font-size: 24rpx;
  font-weight: 800;
}

.ledger-action.edit {
  color: #9a5949;
}

.ledger-action.danger {
  border-color: #e33d2d;
  background: #f0442f;
  box-shadow: 0 8rpx 18rpx rgba(240, 68, 47, 0.2);
  color: #fff;
}

.ledger-bottom-actions {
  position: fixed;
  right: 28rpx;
  bottom: env(safe-area-inset-bottom);
  left: 28rpx;
  z-index: 20;
  display: flex;
  gap: 18rpx;
  box-sizing: border-box;
  background: rgba(255, 250, 247, 0.94);
  box-shadow: 0 -12rpx 30rpx rgba(104, 63, 47, 0.08);
}

.ledger-bottom-button {
  flex: 1;
  height: 82rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 82rpx;
  text-align: center;
}

.ledger-bottom-button.secondary {
  border: 1rpx solid rgba(240, 68, 47, 0.18);
  background: #fffdfb;
  color: #f0442f;
}

.ledger-bottom-button.primary {
  background: #f0442f;
  box-shadow: 0 14rpx 28rpx rgba(240, 68, 47, 0.16);
  color: #fff;
}

.member-avatar-status {
  color: #a58c82;
  font-size: 22rpx;
  font-weight: 700;
}

.member-avatar-status.error {
  color: #d9483b;
}
