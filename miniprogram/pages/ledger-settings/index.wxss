.ledger-settings-page .page-content {
  padding-bottom: calc(24px + 82rpx);
}

.settings-card {
  padding: 34rpx;
}

.empty-card {
  display: flex;
  min-height: 360rpx;
  align-items: center;
  justify-content: center;
}

.ledger-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.ledger-card {
  min-height: 214rpx;
  padding: 30rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(240, 68, 47, 0.08);
  background: rgba(255, 255, 255, 0.94);
}

.ledger-name {
  overflow: hidden;
  color: var(--tl-color-text);
  font-size: var(--tl-font-heading);
  font-weight: var(--tl-font-weight-bold);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ledger-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.ledger-tag {
  padding: 7rpx 16rpx;
  border-radius: var(--tl-radius-pill);
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
  line-height: 1.2;
}

.type-tag.personal {
  color: var(--tl-color-tag-personal);
  background: var(--tl-color-tag-personal-bg);
}

.type-tag.shared {
  color: var(--tl-color-tag-shared);
  background: var(--tl-color-income-soft);
}

.role-tag.owner {
  color: var(--tl-color-danger);
  background: var(--tl-color-tag-owner-bg);
}

.role-tag.member {
  color: var(--tl-color-tag-member);
  background: var(--tl-color-tag-member-bg);
}

.role-tag.visitor {
  color: var(--tl-color-tag-visitor);
  background: var(--tl-color-tag-visitor-bg);
}

.ledger-remark {
  margin-top: 18rpx;
  color: var(--tl-color-text-secondary);
  font-size: var(--tl-font-body-sm);
  line-height: 1.6;
}

.ledger-members {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 22rpx;
}

.member-stack {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  min-height: 52rpx;
  padding-left: 4rpx;
}

.member-avatar {
  display: block;
  flex: 0 0 52rpx;
  width: 52rpx;
  height: 52rpx;
  margin-left: -16rpx;
  box-sizing: border-box;
  border: 3rpx solid var(--tl-color-surface);
  border-radius: 50%;
  background: var(--tl-color-primary-soft);
}

.member-avatar:first-child {
  margin-left: 0;
}

.member-summary {
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
}

.ledger-card-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--tl-color-divider);
}

.ledger-action {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-height: 68rpx;
  border: 2rpx solid var(--tl-color-border-warm);
  border-radius: var(--tl-radius-control);
  background: var(--tl-color-surface);
  color: var(--tl-color-text-secondary);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
}

.ledger-action.edit {
  color: var(--tl-color-text);
}

.ledger-action.danger {
  border-color: var(--tl-color-danger);
  background: var(--tl-color-primary);
  color: var(--tl-color-text-inverse);
}

.member-avatar-status {
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
}

.member-avatar-status.error {
  color: var(--tl-color-danger);
}

.ledger-edit-dialog {
  width: 100%;
  padding: 42rpx 34rpx 30rpx;
  box-sizing: border-box;
}

.edit-dialog-title {
  color: var(--tl-color-text);
  font-size: var(--tl-font-heading);
  font-weight: var(--tl-font-weight-bold);
  text-align: center;
}

.edit-dialog-copy {
  margin-top: 10rpx;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
  text-align: center;
}

.edit-field {
  margin-top: 28rpx;
}

.edit-field-label {
  margin-bottom: 14rpx;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
}

.required-star {
  color: var(--tl-color-primary);
}

.optional-tip {
  padding-left: 6rpx;
  font-weight: var(--tl-font-weight-regular);
}

.edit-input,
.edit-textarea {
  display: block;
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid rgba(240, 68, 47, 0.1);
  border-radius: var(--tl-radius-control);
  background: var(--tl-color-page);
  color: var(--tl-color-text);
  font-size: var(--tl-font-body);
  font-weight: var(--tl-font-weight-bold);
}

.edit-input {
  height: var(--tl-control-height-md);
  padding: 0 24rpx;
}

.edit-textarea {
  height: 156rpx;
  padding: 22rpx 24rpx;
  line-height: 1.45;
}

.edit-dialog-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 32rpx;
}
