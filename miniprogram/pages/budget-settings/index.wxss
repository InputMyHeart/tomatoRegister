.setting-card,
.budget-card {
  padding: 32rpx;
}

.setting-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.setting-title {
  color: #312522;
  font-size: 34rpx;
  font-weight: 900;
}

.setting-subtitle {
  color: #9a8278;
  font-size: 24rpx;
  font-weight: 700;
  margin-top: 10rpx;
  line-height: 1.45;
}

.budget-card {
  margin-top: 24rpx;
}

.budget-card.is-disabled {
  opacity: 0.58;
}

.amount-label {
  color: #9a8278;
  font-size: 26rpx;
  font-weight: 800;
}

.amount-input-row {
  height: 112rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  border-bottom: 1rpx solid #f3e5df;
}

.currency {
  color: #f0442f;
  font-size: 38rpx;
  font-weight: 900;
}

.amount-input {
  flex: 1;
  min-width: 0;
  color: #312522;
  font-size: 54rpx;
  font-weight: 900;
}

.budget-settings-page .page-content {
  padding-bottom: calc(24px + 92rpx);
}

.save-bar {
  position: fixed;
  right: 28rpx;
  bottom: env(safe-area-inset-bottom);
  left: 28rpx;
  z-index: 20;
  background: rgba(255, 247, 242, 0.94);
  backdrop-filter: blur(18rpx);
}

.save-button {
  width: 100%;
}

.save-button[disabled],
.save-button.is-saving {
  color: #ffffff;
  opacity: 0.92;
}

.save-button-inner {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  color: #ffffff;
}

.save-spinner {
  width: 32rpx;
  height: 32rpx;
  box-sizing: border-box;
  border: 4rpx solid rgba(255, 255, 255, 0.45);
  border-top-color: #ffffff;
  border-radius: 50%;
  animation: saveButtonSpin 760ms linear infinite;
}

@keyframes saveButtonSpin {
  to {
    transform: rotate(360deg);
  }
}
