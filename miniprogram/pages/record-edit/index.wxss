.selected-card,
.selected-left {
  display: flex;
  align-items: center;
}

.selected-card {
  justify-content: space-between;
  margin-bottom: 22rpx;
  padding: 24rpx;
}

.selected-left {
  min-width: 0;
  gap: 14rpx;
}

.type-badge {
  height: 54rpx;
  padding: 0 16rpx;
  border-radius: var(--tl-radius-pill);
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
}

.type-badge.expense {
  color: var(--tl-color-primary);
  background: var(--tl-color-primary-soft);
}

.type-badge.income {
  color: var(--tl-color-income);
  background: var(--tl-color-income-soft);
}

.selected-icon {
  width: 74rpx;
  height: 74rpx;
  border-radius: var(--tl-radius-md);
  flex: 0 0 74rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--tl-color-primary-soft);
}

.selected-icon.income {
  background: var(--tl-color-income-soft);
}

.selected-text {
  min-width: 0;
}

.selected-name {
  max-width: 360rpx;
  color: var(--tl-color-text);
  font-size: var(--tl-font-heading);
  font-weight: var(--tl-font-weight-bold);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.selected-meta {
  max-width: 360rpx;
  margin-top: 6rpx;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.change-link {
  color: var(--tl-color-primary);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
  flex: 0 0 auto;
}

.record-timestamps {
  margin: 18rpx 16rpx 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  color: #a89289;
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-semibold);
  line-height: 32rpx;
  text-align: center;
}

.record-actions {
  display: grid;
  width: 100%;
  grid-template-columns: 1fr;
  gap: var(--tl-space-sm);
}

.record-actions.has-delete {
  grid-template-columns: 220rpx minmax(0, 1fr);
}
