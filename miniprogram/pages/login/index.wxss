.login-page {
  box-sizing: border-box;
  width: 100%;
  height: 100vh;
  min-height: 100vh;
  padding: 0 28rpx;
  background: var(--tl-background-page);
  display: flex;
  overflow: hidden;
}

.login-scroll {
  display: block;
  width: 100%;
  height: 100%;
  min-height: 0;
  flex: 1 1 0;
}

.login-content {
  min-height: 100%;
  padding: 0 22rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.login-logo {
  width: 188rpx;
  height: 188rpx;
}

.login-title {
  margin-top: 32rpx;
  color: var(--tl-color-text);
  font-size: var(--tl-font-size-2xl);
  font-weight: var(--tl-font-weight-bold);
  line-height: 1.15;
}

.login-subtitle {
  margin-top: 16rpx;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-body);
  font-weight: var(--tl-font-weight-bold);
}

.login-button {
  width: 420rpx;
  margin-top: 72rpx;
}
