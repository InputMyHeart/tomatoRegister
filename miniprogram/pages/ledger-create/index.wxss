.ledger-create-page {
  position: relative;
}

.ledger-create-content {
  min-height: 100%;
  padding-bottom: 24px;
}

.scene {
  position: relative;
  min-height: 420rpx;
  padding-top: 38rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  transition:
    min-height 320ms ease,
    transform 320ms ease;
}

.scene-detail {
  min-height: 286rpx;
  transform: translateY(-8rpx);
}

.logo-glow {
  position: absolute;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: rgba(240, 68, 47, 0.08);
  animation: logoPulse 3.2s ease-in-out infinite;
}

.brand-logo {
  position: relative;
  z-index: 1;
  width: 146rpx;
  height: 146rpx;
}

.scene-title {
  position: relative;
  z-index: 1;
  margin-top: 28rpx;
  color: var(--tl-color-text);
  font-size: var(--tl-font-data);
  font-weight: var(--tl-font-weight-bold);
}

.scene-subtitle {
  position: relative;
  z-index: 1;
  margin-top: 12rpx;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
}

.type-grid {
  display: grid;
  gap: 22rpx;
}

.type-option {
  min-height: 152rpx;
  padding: 26rpx;
  border-radius: var(--tl-radius-md);
  background: var(--tl-color-surface);
  border: 1rpx solid var(--tint);
  display: flex;
  align-items: center;
  transition: transform 180ms ease;
}

.type-option:active {
  transform: scale(0.985);
}

.type-icon {
  width: 82rpx;
  height: 82rpx;
  flex: 0 0 82rpx;
  border-radius: var(--tl-radius-md);
  background: rgba(255, 255, 255, 0.74);
  display: flex;
  align-items: center;
  justify-content: center;
}

.type-main {
  min-width: 0;
  padding-left: 22rpx;
}

.type-title {
  color: var(--tl-color-text);
  font-size: var(--tl-font-heading);
  font-weight: var(--tl-font-weight-bold);
}

.type-subtitle {
  margin-top: 8rpx;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
}

.step-line {
  position: relative;
  height: 62rpx;
  margin-bottom: 20rpx;
}

.back-type {
  position: absolute;
  right: 0;
  top: 5rpx;
  width: 88rpx;
  min-width: 88rpx;
  height: 52rpx;
  padding: 0;
  border-radius: var(--tl-radius-pill);
  font-size: var(--tl-font-caption);
  line-height: 1;

  display: flex;
  align-items: center;
  justify-content: center;
}

.selected-pill {
  position: absolute;
  left: 50%;
  top: 0;
  width: 330rpx;
  height: 62rpx;
  padding: 0 34rpx;
  border-radius: var(--tl-radius-pill);
  background: var(--tl-color-primary-soft);
  color: var(--tl-color-primary);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
  line-height: 1;
  text-align: center;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.form-panel {
  box-sizing: border-box;
  padding: 30rpx;
  border-radius: var(--tl-radius-md);
  background: rgba(255, 253, 252, 0.96);
  border: 1rpx solid rgba(240, 68, 47, 0.08);
}

.field-block + .field-block {
  margin-top: 26rpx;
}

.field-label {
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
  margin-bottom: 14rpx;
}

.required-star {
  color: var(--tl-color-primary);
  padding-left: 4rpx;
}

.optional-tip {
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
  padding-left: 6rpx;
}

.ledger-input,
.ledger-textarea {
  box-sizing: border-box;
  width: 100%;
  border-radius: var(--tl-radius-control);
  background: var(--tl-color-page);
  color: var(--tl-color-text);
  font-size: var(--tl-font-body);
  font-weight: var(--tl-font-weight-bold);
  border: 1rpx solid rgba(240, 68, 47, 0.1);
}

.ledger-input {
  height: var(--tl-control-height-md);
  padding: 0 24rpx;
}

.ledger-textarea {
  display: block;
  height: 156rpx;
  padding: 22rpx 24rpx;
  line-height: 1.45;
}

.result-sheet {
  width: 100%;
  box-sizing: border-box;
}

.result-title {
  margin-top: 24rpx;
  text-align: center;
  color: var(--tl-color-text);
  font-size: var(--tl-font-data);
  font-weight: var(--tl-font-weight-bold);
}

.result-summary {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 30rpx;
}

.summary-item {
  min-width: 0;
  padding: 22rpx 18rpx;
  border-radius: var(--tl-radius-control);
  background: var(--tl-color-page);
  border: 1rpx solid rgba(240, 68, 47, 0.08);
}

.summary-label,
.sheet-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--tl-space-md);
  margin-top: var(--tl-space-lg);
}

.summary-value {
  display: block;
  text-align: center;
}

.summary-label {
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
}

.summary-value {
  margin-top: 10rpx;
  color: var(--tl-color-text);
  font-size: var(--tl-font-body);
  font-weight: var(--tl-font-weight-bold);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

@keyframes logoPulse {
  50% {
    transform: scale(1.06);
    opacity: 0.82;
  }
}

.budget-switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.budget-switch-row .field-label {
  margin-bottom: 0;
}
.budget-switch-tip {
  margin-top: 8rpx;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
}
.budget-toggle {
  position: relative;
  width: 146rpx;
  height: 58rpx;
  flex: 0 0 146rpx;
  padding: 0 12rpx;
  box-sizing: border-box;
  border-radius: var(--tl-radius-pill);
  background: #ded4cf;
  color: var(--tl-color-text-inverse);
  display: flex;
  align-items: center;
  justify-content: flex-end;
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
}
.budget-toggle.is-on {
  justify-content: flex-start;
  background: var(--tl-color-primary);
}
.budget-toggle-knob {
  position: absolute;
  left: 6rpx;
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background: var(--tl-color-surface);
}
.budget-toggle.is-on .budget-toggle-knob {
  transform: translateX(88rpx);
}
.budget-input-wrap {
  margin-top: 26rpx;
}
.budget-input-row {
  height: var(--tl-control-height-md);
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: var(--tl-radius-control);
  background: var(--tl-color-page);
  border: 1rpx solid rgba(240, 68, 47, 0.1);
  color: var(--tl-color-primary);
  font-size: var(--tl-font-heading);
  font-weight: var(--tl-font-weight-bold);
}
.budget-input {
  flex: 1;
  min-width: 0;
  color: var(--tl-color-text);
  font-size: var(--tl-font-body);
  font-weight: var(--tl-font-weight-bold);
}

.quick-amount-guide {
  grid-column: 1 / -1;
  margin-top: 18rpx;
  padding: 18rpx 22rpx;
  border-radius: var(--tl-radius-control);
  color: var(--tl-color-danger);
  background: var(--tl-color-primary-soft);
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
  line-height: 1.5;
}
