.detail-hero,
.detail-card {
  padding: 32rpx;
}

.detail-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: var(--tl-color-primary-soft);
}

.type-mark {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--tl-radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
}

.type-mark.expense {
  background: var(--tl-color-primary-soft);
}
.type-mark.income {
  background: var(--tl-color-income-soft);
}

.category-name {
  margin-top: 22rpx;
  color: var(--tl-color-text);
  font-size: var(--tl-font-data);
  font-weight: var(--tl-font-weight-bold);
}

.category-path {
  margin-top: 8rpx;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
}

.amount {
  margin-top: 22rpx;
  font-size: var(--tl-font-size-2xl);
  font-weight: var(--tl-font-weight-bold);
}

.amount.expense {
  color: var(--tl-color-primary);
}
.amount.income {
  color: var(--tl-color-income);
}

.detail-card {
  margin-top: 24rpx;
}

.detail-row,
.member-row {
  min-height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 28rpx;
  border-bottom: 1rpx solid #f3e5df;
}

.detail-row:last-child {
  border-bottom: none;
}

.detail-label {
  flex: 0 0 auto;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
}

.detail-value {
  min-width: 0;
  color: var(--tl-color-text);
  font-size: var(--tl-font-body);
  font-weight: var(--tl-font-weight-bold);
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-info {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.member-avatar {
  width: 46rpx;
  height: 46rpx;
  flex: 0 0 46rpx;
  border-radius: 50%;
  background: var(--tl-color-primary-soft);
}

.member-name {
  min-width: 0;
  color: var(--tl-color-text);
  font-size: var(--tl-font-body);
  font-weight: var(--tl-font-weight-bold);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.note-block {
  padding-top: 26rpx;
}

.note-text {
  margin-top: 14rpx;
  color: var(--tl-color-text);
  font-size: var(--tl-font-body);
  font-weight: var(--tl-font-weight-bold);
  line-height: 1.5;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
}

.tag-chip {
  padding: 8rpx 16rpx;
  border-radius: var(--tl-radius-pill);
  color: var(--tl-color-primary);
  background: var(--tl-color-primary-soft);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
}

.loading-card,
.empty-card {
  min-height: 420rpx;
}
