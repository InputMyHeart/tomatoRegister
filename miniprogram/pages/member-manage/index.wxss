.member-manage-page .page-content {
  padding-bottom: 24px;
}
.page-head {
  margin: 18rpx 2rpx 22rpx;
}
.ledger-name {
  color: var(--tl-color-text);
  font-size: var(--tl-font-data);
  font-weight: var(--tl-font-weight-bold);
}
.ledger-tip {
  margin-top: 8rpx;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
}
.member-card {
  overflow: hidden;
  padding: 0 26rpx;
}
.member-row {
  display: flex;
  min-height: var(--tl-list-row-height);
  align-items: center;
  border-bottom: 1rpx solid var(--tl-color-divider);
}
.member-row:last-child {
  border-bottom: 0;
}
.member-avatar {
  width: 68rpx;
  height: 68rpx;
  flex: 0 0 68rpx;
  border-radius: 50%;
  background: var(--tl-color-primary-soft);
}
.member-info {
  min-width: 0;
  flex: 1;
  margin-left: 18rpx;
}
.member-name {
  overflow: hidden;
  color: var(--tl-color-text);
  font-size: var(--tl-font-body);
  font-weight: var(--tl-font-weight-bold);
  text-overflow: ellipsis;
  white-space: nowrap;
}
.member-role {
  display: inline-flex;
  margin-top: 7rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--tl-radius-pill);
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
}
.member-role.owner {
  color: var(--tl-color-danger);
  background: #ffe9e4;
}
.member-role.member {
  color: #2f7163;
  background: var(--tl-color-income-soft);
}
.member-role.visitor {
  color: #7a6a90;
  background: #f1edf7;
}
.member-remove {
  display: inline-flex;
  min-height: 58rpx;
  padding: 12rpx 18rpx;
  align-items: center;
  justify-content: center;
  line-height: 1;
  color: var(--tl-color-primary);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
}

.readonly-tip,
.state-card {
  padding: 36rpx 24rpx;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
  text-align: center;
}

.share-sheet {
  width: 100%;
}
.sheet-title {
  margin-bottom: 22rpx;
  color: var(--tl-color-text);
  font-size: var(--tl-font-heading);
  font-weight: var(--tl-font-weight-bold);
}
.share-option {
  width: 100%;
  min-height: var(--tl-list-row-height);
  margin: 12rpx 0;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--tl-color-divider);
  border-radius: var(--tl-radius-control);
  background: var(--tl-color-surface);
  color: var(--tl-color-text);
  text-align: left;
  font-size: var(--tl-font-body);
  font-weight: var(--tl-font-weight-bold);
}
.share-option::after {
  border: 0;
}
.share-option text {
  display: block;
  margin-top: 6rpx;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
}
