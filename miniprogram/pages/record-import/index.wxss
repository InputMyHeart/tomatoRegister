.record-import-page .page-content {
  padding: 32rpx 30rpx 24px;
  box-sizing: border-box;
}
.hero-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx;
  background: var(--tl-color-primary-soft);
}
.hero-icon {
  display: flex;
  width: 86rpx;
  height: 86rpx;
  align-items: center;
  justify-content: center;
  border-radius: var(--tl-radius-control);
  background: #ffe6df;
}
.hero-title,
.card-title,
.result-title {
  color: var(--tl-color-text);
  font-size: var(--tl-font-heading);
  font-weight: var(--tl-font-weight-bold);
}
.hero-copy,
.template-copy,
.import-note,
.result-copy {
  margin-top: 8rpx;
  color: #967f76;
  font-size: var(--tl-font-caption);
  line-height: 1.6;
}
.import-card {
  margin-top: 22rpx;
  padding: 34rpx;
}
.field-label {
  margin-top: 28rpx;
  color: var(--tl-color-text-secondary);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
}
.picker-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
  padding: 21rpx;
  border: 2rpx solid #f3dfd8;
  border-radius: var(--tl-radius-control);
  color: var(--tl-color-text);
  font-size: var(--tl-font-body);
}
.template-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 26rpx;
  padding: 20rpx;
  border-radius: var(--tl-radius-control);
  background: #fff7f3;
}
.template-title {
  color: #6f4a41;
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
}
.template-button {
  display: inline-flex;
  min-height: 58rpx;
  flex: 0 0 auto;
  padding: 13rpx 18rpx;
  align-items: center;
  justify-content: center;
  line-height: 1;
  border-radius: var(--tl-radius-xs);
  background: #ffe5de;
  color: var(--tl-color-primary);
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
}

.import-note {
  text-align: center;
}

.result-dialog {
  width: 100%;
  padding: 42rpx 34rpx 30rpx;
  box-sizing: border-box;
}
.result-title {
  text-align: center;
  font-size: var(--tl-font-heading);
}
.result-copy {
  text-align: center;
}
.result-grid {
  display: flex;
  gap: 18rpx;
  margin-top: 30rpx;
}
.result-grid view {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 8rpx;
  padding: 22rpx 12rpx;
  border-radius: var(--tl-radius-control);
  background: #fff4ef;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
  text-align: center;
}
.result-number {
  font-size: var(--tl-font-data);
  font-weight: var(--tl-font-weight-bold);
}
.success {
  color: var(--tl-color-income);
}
.fail {
  color: var(--tl-color-danger);
}
.error-list {
  display: flex;
  flex-direction: column;
  gap: 7rpx;
  max-height: 140rpx;
  margin-top: 18rpx;
  overflow: auto;
  color: var(--tl-color-danger);
  font-size: var(--tl-font-caption);
}
.dialog-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 32rpx;
}
