.tl-navbar {
  display: block;
  flex: 0 0 auto;
  width: 100%;
  margin-bottom: 22rpx;
  background: transparent;
}

.nav-row,
.nav-brand {
  display: flex;
  align-items: center;
}

.nav-row {
  position: relative;
  justify-content: space-between;
}

.nav-brand,
.nav-right {
  width: 220rpx;
  min-width: 0;
}

.brand-mark,
.back-button {
  position: relative;
  width: 54rpx;
  height: 54rpx;
  flex: 0 0 54rpx;
  margin-right: 12rpx;
  border-radius: var(--tl-radius-control);
  display: flex;
  align-items: center;
  justify-content: center;
}

.brand-mark {
  overflow: visible;
}

.back-button {
  background: rgba(255, 255, 255, 0.72);
  color: var(--tl-color-primary);
  font-size: var(--tl-font-data);
  font-weight: var(--tl-font-weight-bold);
  line-height: 1;
}

.brand-name {
  color: var(--tl-color-text);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
  white-space: nowrap;
}

.nav-center {
  position: absolute;
  left: 50%;
  max-width: 250rpx;
  transform: translateX(-50%);
  color: var(--tl-color-text);
  font-size: var(--tl-font-body);
  font-weight: var(--tl-font-weight-bold);
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.back-button {
  box-sizing: border-box;
  text-align: center;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.back-button tl-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}
