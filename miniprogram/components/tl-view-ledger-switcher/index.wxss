.tl-view-ledger-switcher {
  position: fixed;
  inset: 0;
  z-index: 99;
  display: flex;
  align-items: flex-end;
  background: rgba(35, 24, 21, 0.42);
  animation: mask-fade 180ms ease-out both;
}

.tl-view-ledger-switcher__panel {
  width: 100%;
  max-height: 72vh;
  padding: 18rpx 28rpx calc(34rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  border-radius: 28rpx 28rpx 0 0;
  background: #fffaf7;
  box-shadow: 0 -18rpx 48rpx rgba(78, 44, 34, 0.18);
  animation: panel-up 240ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
}

.tl-view-ledger-switcher__handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 22rpx;
  border-radius: 999rpx;
  background: #eadbd4;
}

.tl-view-ledger-switcher__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 22rpx;
}

.tl-view-ledger-switcher__title {
  color: #2f211c;
  font-size: 34rpx;
  font-weight: 700;
}

.tl-view-ledger-switcher__subtitle,
.tl-view-ledger-switcher__meta {
  color: #9b8a83;
  font-size: 24rpx;
}

.tl-view-ledger-switcher__subtitle {
  margin-top: 6rpx;
}

.tl-view-ledger-switcher__close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  flex: 0 0 56rpx;
  border-radius: 50%;
  color: #8d7b74;
  background: #f3e8e3;
  font-size: 42rpx;
  line-height: 1;
}

.tl-view-ledger-switcher__list {
  max-height: 46vh;
  padding: 0 2rpx;
}

.tl-view-ledger-switcher__item {
  display: flex;
  align-items: center;
  min-height: 108rpx;
  gap: 20rpx;
  margin-bottom: 16rpx;
  padding: 20rpx 22rpx;
  border: 2rpx solid #f1e5df;
  border-radius: 18rpx;
  background: #ffffff;
}

.tl-view-ledger-switcher__item.is-viewing {
  border-color: #f0442f;
  background: #fff2ee;
}

.tl-view-ledger-switcher__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 66rpx;
  height: 66rpx;
  flex: 0 0 66rpx;
  border-radius: 22rpx;
  background: #fff0ea;
}

.tl-view-ledger-switcher__content {
  min-width: 0;
  flex: 1;
}

.tl-view-ledger-switcher__name {
  display: block;
  overflow: hidden;
  color: #34251f;
  font-size: 30rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tl-view-ledger-switcher__meta {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
}

.tl-view-ledger-switcher__current {
  flex: 0 0 auto;
  color: #f0442f;
  font-size: 22rpx;
  font-weight: 800;
}

.tl-view-ledger-switcher__state {
  min-height: 260rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  color: #8d7b74;
  font-size: 26rpx;
  font-weight: 700;
}

.tl-view-ledger-switcher__spinner {
  width: 42rpx;
  height: 42rpx;
  border: 5rpx solid #ffe1d9;
  border-top-color: #f0442f;
  border-radius: 50%;
  animation: spinner 720ms linear infinite;
}

.tl-view-ledger-switcher__retry {
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  color: #f0442f;
  background: #fff0ea;
}

@keyframes mask-fade {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes panel-up {
  from {
    opacity: 0.96;
    transform: translateY(42rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes spinner {
  to {
    transform: rotate(360deg);
  }
}
