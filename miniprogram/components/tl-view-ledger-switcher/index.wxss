.tl-view-ledger-switcher__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 22rpx;
}

.tl-view-ledger-switcher__title {
  color: var(--tl-color-text);
  font-size: var(--tl-font-heading);
  font-weight: var(--tl-font-weight-bold);
}

.tl-view-ledger-switcher__subtitle,
.tl-view-ledger-switcher__meta {
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-body-sm);
}

.tl-view-ledger-switcher__subtitle {
  margin-top: 6rpx;
}

.tl-view-ledger-switcher__close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  flex: 0 0 56rpx;
  border-radius: 50%;
  color: var(--tl-color-text-tertiary);
  background: #f3e8e3;
  font-size: var(--tl-font-data);
  line-height: 1;
}

.tl-view-ledger-switcher__list {
  max-height: 46vh;
  padding: 0 2rpx;
}

.tl-view-ledger-switcher__item {
  display: flex;
  align-items: center;
  min-height: var(--tl-list-row-height);
  gap: 20rpx;
  margin-bottom: 16rpx;
  padding: 20rpx 22rpx;
  border: 2rpx solid var(--tl-color-divider);
  border-radius: var(--tl-radius-control);
  background: var(--tl-color-surface);
}

.tl-view-ledger-switcher__item.is-viewing {
  border-color: #f0442f;
  background: #fff2ee;
}

.tl-view-ledger-switcher__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 66rpx;
  height: 66rpx;
  flex: 0 0 66rpx;
  border-radius: var(--tl-radius-control);
  background: var(--tl-color-primary-soft);
}

.tl-view-ledger-switcher__content {
  min-width: 0;
  flex: 1;
}

.tl-view-ledger-switcher__name {
  display: block;
  overflow: hidden;
  color: var(--tl-color-text);
  font-size: var(--tl-font-body);
  font-weight: var(--tl-font-weight-bold);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tl-view-ledger-switcher__meta {
  display: block;
  margin-top: 8rpx;
  font-size: var(--tl-font-caption);
}

.tl-view-ledger-switcher__current {
  flex: 0 0 auto;
  color: var(--tl-color-primary);
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
}

.tl-view-ledger-switcher__state {
  min-height: 260rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
}

.tl-view-ledger-switcher__spinner {
  width: 42rpx;
  height: 42rpx;
  border: 5rpx solid #ffe1d9;
  border-top-color: #f0442f;
  border-radius: 50%;
  animation: spinner 720ms linear infinite;
}

.tl-view-ledger-switcher__retry {
  padding: 14rpx 24rpx;
  border-radius: var(--tl-radius-pill);
  color: var(--tl-color-primary);
  background: var(--tl-color-primary-soft);
}

@keyframes spinner {
  to {
    transform: rotate(360deg);
  }
}
