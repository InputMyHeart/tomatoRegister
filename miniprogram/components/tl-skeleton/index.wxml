<view class="skeleton skeleton-{{variant}}">
  <block wx:if="{{variant === 'home'}}">
    <view class="skeleton-hero">
      <view class="skeleton-hero-main">
        <view class="skeleton-row">
          <view class="skeleton-item home-title">
          </view>
          <view class="skeleton-item home-tag">
          </view>
          <view class="skeleton-item home-arrow">
          </view>
        </view>
        <view class="skeleton-item home-month">
        </view>
      </view>
      <view class="skeleton-item home-logo">
      </view>
    </view>
    <view class="skeleton-card">
      <view class="skeleton-item card-title">
      </view>
      <view class="skeleton-item card-line wide">
      </view>
      <view class="skeleton-grid">
        <view class="skeleton-item grid-block" wx:for="{{gridItems}}" wx:key="*this">
        </view>
      </view>
      <view class="skeleton-item card-line">
      </view>
      <view class="skeleton-item card-line short">
      </view>
    </view>
  </block>
  <block wx:elif="{{variant === 'records'}}">
    <view class="skeleton-record-card" wx:for="{{recordCards}}" wx:key="*this">
      <view class="skeleton-record-head">
        <view class="skeleton-item record-date">
        </view>
        <view class="skeleton-item record-total">
        </view>
      </view>
      <view class="skeleton-record-row" wx:for="{{recordRows}}" wx:for-item="row" wx:key="*this">
        <view class="skeleton-item record-icon">
        </view>
        <view class="skeleton-record-main">
          <view class="skeleton-item record-line">
          </view>
          <view class="skeleton-item record-line short">
          </view>
        </view>
      </view>
    </view>
  </block>
  <block wx:elif="{{variant === 'list'}}">
    <view class="skeleton-card skeleton-generic-card" wx:for="{{recordCards}}" wx:key="*this">
      <view class="skeleton-item card-title">
      </view>
      <view class="skeleton-item card-line wide">
      </view>
      <view class="skeleton-item card-line">
      </view>
    </view>
  </block>
  <block wx:elif="{{variant === 'detail'}}">
    <view class="skeleton-card skeleton-detail-hero">
      <view class="skeleton-item detail-icon">
      </view>
      <view class="skeleton-item analysis-balance">
      </view>
      <view class="skeleton-item card-line short">
      </view>
    </view>
    <view class="skeleton-card skeleton-generic-card" wx:for="{{recordRows}}" wx:key="*this">
      <view class="skeleton-item card-line wide">
      </view>
      <view class="skeleton-item card-line">
      </view>
    </view>
  </block>
  <block wx:else>
    <view class="skeleton-card analysis-overview">
      <view class="skeleton-row spaced">
        <view class="skeleton-item card-title">
        </view>
        <view class="skeleton-item analysis-badge">
        </view>
      </view>
      <view class="skeleton-item analysis-balance">
      </view>
      <view class="skeleton-grid">
        <view class="skeleton-item grid-block small" wx:for="{{gridItems}}" wx:key="*this">
        </view>
      </view>
    </view>
    <view class="skeleton-item analysis-heading">
    </view>
    <view class="skeleton-card analysis-chart">
      <view class="skeleton-item chart-area">
      </view>
    </view>
  </block>
</view>
