<view class="tab-panel analysis-page">
  <scroll-view class="analysis-scroll" scroll-y="{{true}}" enhanced="{{true}}" enable-flex="{{true}}" show-scrollbar="{{false}}">
    <view class="page-content">
      <view class="analysis-header fade-up">
        <view class="analysis-context-bar">
          <view class="context-ledger" bindtap="switchLedger">
            <text class="ledger-name">{{ledgerName}}</text>
            <tl-icon name="arrow-down-s-line" size="24" color="#f0442f"></tl-icon>
          </view>
          <view class="context-divider"></view>
          <view wx:if="{{mode !== 'custom'}}" class="context-period {{mode === 'all' ? 'is-static' : ''}}">
            <view wx:if="{{mode !== 'all'}}" class="context-nav" data-delta="-1" bindtap="shift"><tl-icon name="arrow-left-s-line" size="28" color="#f0442f"></tl-icon></view>
            <text class="context-period-text">{{mode === 'all' ? '全部时间' : rangeLabel}}</text>
            <view wx:if="{{mode !== 'all'}}" class="context-nav" data-delta="1" bindtap="shift"><tl-icon name="arrow-right-s-line" size="28" color="#f0442f"></tl-icon></view>
          </view>
          <view wx:else class="context-period is-static"><text class="context-period-text">{{rangeLabel}}</text></view>
          <view class="context-divider"></view>
          <view class="context-mode-picker" bindtap="openModeSheet">
            <view class="context-mode"><text>{{modeLabel}}</text><tl-icon name="arrow-down-s-line" size="24" color="#f0442f"></tl-icon></view>
          </view>
        </view>
        <view wx:if="{{mode === 'custom'}}" class="custom-range">
          <picker mode="date" value="{{customStart}}" end="{{customEnd}}" bindchange="changeCustomStart"><view class="custom-date-picker"><text class="custom-date-label">开始</text><text>{{customStart}}</text></view></picker>
          <text class="custom-range-divider">至</text>
          <picker mode="date" value="{{customEnd}}" start="{{customStart}}" bindchange="changeCustomEnd"><view class="custom-date-picker"><text class="custom-date-label">结束</text><text>{{customEnd}}</text></view></picker>
        </view>
      </view>
      <tl-skeleton wx:if="{{loading}}" variant="analysis">
      </tl-skeleton>
      <tl-empty-state wx:elif="{{error}}" variant="error" title="分析数据加载失败" description="请检查网络后重新加载">
        <tl-button variant="secondary" size="small" bind:tap="reload">重新加载</tl-button>
      </tl-empty-state>
      <tl-empty-state wx:elif="{{noLedger}}" title="还没有可分析的账本" description="创建账本并记下第一笔收支后，这里会生成分析">
      </tl-empty-state>
      <tl-empty-state wx:elif="{{!hasRecords}}" title="这个时段还没有记录" description="换一个时间范围，或者先记下第一笔收支">
      </tl-empty-state>
      <block wx:else>
        <block wx:if="{{mode === 'calendar'}}">
          <view class="calendar-card card fade-up">
            <view class="calendar-weekdays"><text>日</text><text>一</text><text>二</text><text>三</text><text>四</text><text>五</text><text>六</text></view>
            <view class="calendar-grid">
              <view wx:for="{{calendarCells}}" wx:key="key" class="calendar-cell {{item.blank ? 'is-blank' : ''}} {{item.isStriped ? 'is-striped' : ''}} {{item.isActive ? 'is-active' : ''}} {{item.isToday ? 'is-today' : ''}}" data-date="{{item.date}}" bindtap="selectCalendarDay">
                <text wx:if="{{!item.blank}}" class="calendar-day">{{item.day}}</text>
                <view wx:if="{{item.hasRecords}}" class="calendar-money"><text wx:if="{{item.hasExpense}}" class="calendar-expense">-{{item.expenseText}}</text><text wx:if="{{item.hasIncome}}" class="calendar-income">+{{item.incomeText}}</text></view>
              </view>
            </view>
          </view>
          <view class="calendar-records-head fade-up"><text class="section-kicker">当日明细</text><text>{{selectedCalendarDateLabel}}</text></view>
          <view wx:if="{{selectedCalendarRecords.length}}" class="calendar-records card fade-up">
            <view wx:for="{{selectedCalendarRecords}}" wx:key="_id" class="calendar-record-row">
              <view class="calendar-record-main">
                <text class="calendar-record-category">{{item.categoryText}}</text>
                <view class="calendar-record-meta">
                  <text>{{item.typeLabel}}</text>
                  <text wx:if="{{item.account}}" class="calendar-record-account">{{item.account}}</text>
                </view>
              </view>
              <text class="calendar-record-amount {{item.type}}">{{item.type === 'income' ? '+' : '-'}}¥{{item.amountText}}</text>
            </view>
          </view>
          <view wx:else class="calendar-record-empty card fade-up">这一天还没有记账记录</view>
        </block>
        <block wx:else>
        <view wx:if="{{hasInsights}}" class="insight-card card fade-up">
          <view class="card-heading-row">
            <text class="section-kicker">本期洞察</text>
            <tl-icon name="lightbulb-line" size="36" color="#f0442f">
            </tl-icon>
          </view>
          <view class="insight-list">
            <view wx:if="{{insightGroups.up.length}}" class="insight-group insight-group-up">
              <text class="insight-group-title">上升</text>
              <view wx:for="{{insightGroups.up}}" wx:key="*this" class="insight-item">
                <view class="insight-mark">
                </view>
                <text>{{item}}</text>
              </view>
            </view>
            <view wx:if="{{insightGroups.down.length}}" class="insight-group insight-group-down">
              <text class="insight-group-title">下降</text>
              <view wx:for="{{insightGroups.down}}" wx:key="*this" class="insight-item">
                <view class="insight-mark">
                </view>
                <text>{{item}}</text>
              </view>
            </view>
            <view wx:if="{{insightGroups.neutral.length}}" class="insight-group">
              <text class="insight-group-title">重点</text>
              <view wx:for="{{insightGroups.neutral}}" wx:key="*this" class="insight-item">
                <view class="insight-mark">
                </view>
                <text>{{item}}</text>
              </view>
            </view>
          </view>
        </view>
        <view class="section-head fade-up">
          <text class="section-kicker">数据分析</text>
        </view>
        <scroll-view class="chart-switcher" scroll-x="{{true}}" show-scrollbar="{{false}}">
          <view class="chart-tabs">
            <view class="chart-tab {{activeChart === 'trend' ? 'is-active' : ''}}" data-chart="trend" bindtap="switchChart">收支趋势</view>
            <view class="chart-tab {{activeChart === 'category' ? 'is-active' : ''}}" data-chart="category" bindtap="switchChart">支出构成</view>
            <view wx:if="{{mode !== 'month'}}" class="chart-tab {{activeChart === 'income' ? 'is-active' : ''}}" data-chart="income" bindtap="switchChart">收入来源</view>
            <view wx:if="{{mode !== 'month'}}" class="chart-tab {{activeChart === 'account' ? 'is-active' : ''}}" data-chart="account" bindtap="switchChart">支付账户</view>
            <view wx:if="{{mode !== 'month' && ledgerType === 'shared'}}" class="chart-tab {{activeChart === 'member' ? 'is-active' : ''}}" data-chart="member" bindtap="switchChart">成员录入</view>
          </view>
        </scroll-view>
        <view class="chart-card card fade-up">
          <view class="card-title">{{chartTitle}}</view>
          <view wx:if="{{hasChartData}}" class="analysis-chart-canvas">
            <ec-canvas id="analysis-chart" canvas-id="analysis-chart" ec="{{ec}}" bind:init="onChartInit" bind:initerror="onChartInitError" force-use-old-canvas="true">
            </ec-canvas>
          </view>
          <view wx:else class="empty-copy">这个维度暂时没有可展示的数据</view>
        </view>
        <view wx:if="{{hasDetailRows}}" class="data-panel card fade-up">
          <view class="data-panel-heading">
            <text class="card-title">数据明细</text>
            <text class="data-panel-count">{{activeDetailRows.length}} 项</text>
          </view>
          <scroll-view class="data-panel-scroll" scroll-y="{{true}}" show-scrollbar="{{false}}">
            <view wx:if="{{activeChart === 'trend'}}">
              <view wx:for="{{activeDetailRows}}" wx:key="key" class="trend-data-item">
                <text class="trend-data-label">{{item.label}}</text>
                <view class="trend-data-values">
                  <text>收 ¥{{item.incomeText}}</text>
                  <text>支 ¥{{item.expenseText}}</text>
                  <text>余 ¥{{item.balanceText}}</text>
                </view>
              </view>
            </view>
            <view wx:else class="ranking-list">
              <view wx:for="{{activeDetailRows}}" wx:key="name" class="ranking-item">
                <view class="ranking-main">
                  <text class="ranking-index">{{item.rank}}</text>
                  <text class="ranking-name">{{item.name}}</text>
                  <text class="ranking-rate">{{item.rate}}%</text>
                  <text class="ranking-amount">¥{{item.amountText}}</text>
                </view>
                <view class="ranking-track">
                  <view class="ranking-bar" style="{{item.barStyle}}">
                  </view>
                </view>
              </view>
            </view>
          </scroll-view>
        </view>
        </block>
      </block>
    </view>
  </scroll-view>
  <tl-bottom-sheet visible="{{isModeSheetVisible}}" bind:close="closeModeSheet">
    <view class="analysis-mode-sheet">
      <view class="analysis-mode-sheet__title">选择分析类型</view>
      <view class="analysis-mode-list">
        <view wx:for="{{modeOptions}}" wx:key="value" class="analysis-mode-option {{item.value === mode ? 'is-active' : ''}}" data-mode="{{item.value}}" bindtap="chooseMode">
          <text>{{item.label}}</text>
          <tl-icon wx:if="{{item.value === mode}}" name="check-line" size="32" color="#f0442f"></tl-icon>
        </view>
      </view>
    </view>
  </tl-bottom-sheet>
  <tl-view-ledger-switcher visible="{{isLedgerSwitcherVisible}}" ledgers="{{ledgerOptions}}" viewing-id="{{ledgerId}}" title="切换账本分析" loading="{{isLoadingLedgers}}" error="{{ledgerLoadError}}" bind:select="chooseViewLedger" bind:close="closeLedgerSwitcher" bind:retry="switchLedger">
  </tl-view-ledger-switcher>
</view>
