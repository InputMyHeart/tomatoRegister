<view class="tab-panel analysis-page">
  <scroll-view class="analysis-scroll" scroll-y="{{true}}" enhanced="{{true}}" enable-flex="{{true}}" show-scrollbar="{{false}}">
    <view class="page-content">
      <view class="analysis-header fade-up">
        <view class="analysis-toolbar">
          <view class="ledger-chip" bindtap="switchLedger">
            <text class="ledger-name">{{ledgerName}}</text>
            <tl-icon name="arrow-down-s-line" size="28" color="#f0442f">
            </tl-icon>
          </view>
          <view wx:if="{{mode !== 'custom'}}" class="month-switcher {{mode === 'all' ? 'is-static' : ''}}">
            <view wx:if="{{mode !== 'all'}}" class="month-nav" data-delta="-1" bindtap="shift">
              <tl-icon name="arrow-left-s-line" size="38" color="#f0442f">
              </tl-icon>
            </view>
            <view class="month-text">{{mode === 'all' ? '全部时间' : rangeLabel}}</view>
            <view wx:if="{{mode !== 'all'}}" class="month-nav" data-delta="1" bindtap="shift">
              <tl-icon name="arrow-right-s-line" size="38" color="#f0442f">
              </tl-icon>
            </view>
          </view>
        </view>
        <scroll-view class="analysis-filter-panel" scroll-x="{{true}}" show-scrollbar="{{false}}">
          <view class="segmented">
            <view class="seg-item {{mode === 'month' ? 'active' : ''}}" data-mode="month" bindtap="switchMode">月度</view>
            <view class="seg-item {{mode === 'year' ? 'active' : ''}}" data-mode="year" bindtap="switchMode">年度</view>
            <view class="seg-item {{mode === 'calendar' ? 'active' : ''}}" data-mode="calendar" bindtap="switchMode">日历</view>
            <view class="seg-item {{mode === 'custom' ? 'active' : ''}}" data-mode="custom" bindtap="switchMode">自定义</view>
            <view class="seg-item {{mode === 'all' ? 'active' : ''}}" data-mode="all" bindtap="switchMode">全部</view>
          </view>
        </scroll-view>
        <view wx:if="{{mode === 'custom'}}" class="custom-range">
          <picker mode="date" value="{{customStart}}" end="{{customEnd}}" bindchange="changeCustomStart">
            <view class="custom-date-picker">
              <text class="custom-date-label">开始</text>
              <text>{{customStart}}</text>
            </view>
          </picker>
          <text class="custom-range-divider">至</text>
          <picker mode="date" value="{{customEnd}}" start="{{customStart}}" bindchange="changeCustomEnd">
            <view class="custom-date-picker">
              <text class="custom-date-label">结束</text>
              <text>{{customEnd}}</text>
            </view>
          </picker>
        </view>
      </view>
      <tl-skeleton wx:if="{{loading}}" variant="analysis">
      </tl-skeleton>
      <tl-empty-state wx:elif="{{error}}" variant="error" title="分析数据加载失败" description="请检查网络后重新加载">
        <tl-button variant="secondary" size="small" bind:tap="reload">重新加载</tl-button>
      </tl-empty-state>
      <tl-empty-state wx:elif="{{noLedger}}" title="还没有可分析的账本" description="创建账本并记下第一笔收支后，这里会生成分析">
      </tl-empty-state>
      <tl-empty-state wx:elif="{{!hasRecords}}" title="这个时段还没有记录" description="换一个时间范围，或者先记下第一笔收支">
      </tl-empty-state>
      <block wx:else>
        <view wx:if="{{hasInsights}}" class="insight-card card fade-up">
          <view class="card-heading-row">
            <text class="section-kicker">本期洞察</text>
            <tl-icon name="lightbulb-line" size="36" color="#f0442f">
            </tl-icon>
          </view>
          <view class="insight-list">
            <view wx:if="{{insightGroups.up.length}}" class="insight-group insight-group-up">
              <text class="insight-group-title">上升</text>
              <view wx:for="{{insightGroups.up}}" wx:key="*this" class="insight-item">
                <view class="insight-mark">
                </view>
                <text>{{item}}</text>
              </view>
            </view>
            <view wx:if="{{insightGroups.down.length}}" class="insight-group insight-group-down">
              <text class="insight-group-title">下降</text>
              <view wx:for="{{insightGroups.down}}" wx:key="*this" class="insight-item">
                <view class="insight-mark">
                </view>
                <text>{{item}}</text>
              </view>
            </view>
            <view wx:if="{{insightGroups.neutral.length}}" class="insight-group">
              <text class="insight-group-title">重点</text>
              <view wx:for="{{insightGroups.neutral}}" wx:key="*this" class="insight-item">
                <view class="insight-mark">
                </view>
                <text>{{item}}</text>
              </view>
            </view>
          </view>
        </view>
        <view class="section-head fade-up">
          <text class="section-kicker">数据分析</text>
        </view>
        <scroll-view class="chart-switcher" scroll-x="{{true}}" show-scrollbar="{{false}}">
          <view class="chart-tabs">
            <view class="chart-tab {{activeChart === 'trend' ? 'is-active' : ''}}" data-chart="trend" bindtap="switchChart">收支趋势</view>
            <view class="chart-tab {{activeChart === 'category' ? 'is-active' : ''}}" data-chart="category" bindtap="switchChart">支出构成</view>
            <view class="chart-tab {{activeChart === 'income' ? 'is-active' : ''}}" data-chart="income" bindtap="switchChart">收入来源</view>
            <view class="chart-tab {{activeChart === 'account' ? 'is-active' : ''}}" data-chart="account" bindtap="switchChart">支付账户</view>
            <view wx:if="{{ledgerType === 'shared'}}" class="chart-tab {{activeChart === 'member' ? 'is-active' : ''}}" data-chart="member" bindtap="switchChart">成员录入</view>
          </view>
        </scroll-view>
        <view class="chart-card card fade-up">
          <view class="card-title">{{chartTitle}}</view>
          <view wx:if="{{hasChartData}}" class="analysis-chart-canvas">
            <ec-canvas id="analysis-chart" canvas-id="analysis-chart" ec="{{ec}}" bind:init="onChartInit" bind:initerror="onChartInitError" force-use-old-canvas="true">
            </ec-canvas>
          </view>
          <view wx:else class="empty-copy">这个维度暂时没有可展示的数据</view>
        </view>
        <view wx:if="{{hasDetailRows}}" class="data-panel card fade-up">
          <view class="data-panel-heading">
            <text class="card-title">对应数据</text>
            <text class="data-panel-count">{{activeDetailRows.length}} 项</text>
          </view>
          <scroll-view class="data-panel-scroll" scroll-y="{{true}}" show-scrollbar="{{false}}">
            <view wx:if="{{activeChart === 'trend'}}">
              <view wx:for="{{activeDetailRows}}" wx:key="key" class="trend-data-item">
                <text class="trend-data-label">{{item.label}}</text>
                <view class="trend-data-values">
                  <text>收 ¥{{item.incomeText}}</text>
                  <text>支 ¥{{item.expenseText}}</text>
                  <text>余 ¥{{item.balanceText}}</text>
                </view>
              </view>
            </view>
            <view wx:else class="ranking-list">
              <view wx:for="{{activeDetailRows}}" wx:key="name" class="ranking-item">
                <view class="ranking-main">
                  <text class="ranking-index">{{item.rank}}</text>
                  <text class="ranking-name">{{item.name}}</text>
                  <text class="ranking-rate">{{item.rate}}%</text>
                  <text class="ranking-amount">¥{{item.amountText}}</text>
                </view>
                <view class="ranking-track">
                  <view class="ranking-bar" style="{{item.barStyle}}">
                  </view>
                </view>
              </view>
            </view>
          </scroll-view>
        </view>
      </block>
    </view>
  </scroll-view>
  <tl-view-ledger-switcher visible="{{isLedgerSwitcherVisible}}" ledgers="{{ledgerOptions}}" viewing-id="{{ledgerId}}" title="切换账本分析" loading="{{isLoadingLedgers}}" error="{{ledgerLoadError}}" bind:select="chooseViewLedger" bind:close="closeLedgerSwitcher" bind:retry="switchLedger">
  </tl-view-ledger-switcher>
</view>
