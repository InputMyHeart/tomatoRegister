.section-kicker {
  color: #e76a53;
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
  letter-spacing: 3rpx;
}
.analysis-page .page-content {
  padding-bottom: 24px;
}
.state-card {
  min-height: 300rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9b8379;
  font-size: var(--tl-font-body);
  font-weight: var(--tl-font-weight-bold);
}
.overview-card {
  position: relative;
  overflow: hidden;
  padding: 32rpx;
  background: var(--tl-color-primary-soft);
}
.overview-orb {
  position: absolute;
  right: -86rpx;
  top: -90rpx;
  width: 265rpx;
  height: 265rpx;
  border-radius: 50%;
  background: rgba(244, 87, 59, 0.11);
}
.overview-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.overview-kicker {
  color: #9b8278;
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
}
.overview-title {
  margin-top: 7rpx;
  color: var(--tl-color-text);
  font-size: var(--tl-font-heading);
  font-weight: var(--tl-font-weight-bold);
}
.save-badge {
  position: relative;
  padding: 12rpx 17rpx;
  border-radius: var(--tl-radius-pill);
  background: var(--tl-color-surface);
  color: #e9523e;
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
}
.main-balance {
  position: relative;
  margin-top: 32rpx;
}
.balance-label {
  display: block;
  color: #947c72;
  font-size: var(--tl-font-body-sm);
}
.balance-value {
  display: block;
  margin-top: 5rpx;
  color: var(--tl-color-text);
  font-size: var(--tl-font-data-lg);
  font-weight: var(--tl-font-weight-bold);
  letter-spacing: -2rpx;
}
.money-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 27rpx;
}
.money-cell {
  min-width: 0;
  padding: 19rpx 14rpx;
  border-radius: var(--tl-radius-control);
  background: rgba(255, 255, 255, 0.76);
}
.money-cell text {
  display: block;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
}
.money-cell text:last-child {
  margin-top: 8rpx;
  overflow: hidden;
  color: var(--tl-color-text);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
  text-overflow: ellipsis;
  white-space: nowrap;
}
.income-cell text:last-child {
  color: var(--tl-color-income);
}
.expense-cell text:last-child {
  color: #ef4f39;
}
.section-head {
  margin: 36rpx 4rpx 18rpx;
}
.section-title {
  margin-top: 7rpx;
  color: var(--tl-color-text);
  font-size: var(--tl-font-heading);
  font-weight: var(--tl-font-weight-bold);
}
.chart-switcher {
  display: flex;
  gap: 14rpx;
  margin-bottom: 18rpx;
  overflow-x: auto;
}
.chart-tab {
  flex: 0 0 auto;
  padding: 15rpx 22rpx;
  border-radius: var(--tl-radius-pill);
  background: var(--tl-color-primary-soft);
  color: #977e74;
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
}
.chart-tab.is-active {
  color: var(--tl-color-text-inverse);
  background: #312522;
}
.chart-card {
  padding: 26rpx 28rpx;
}
.empty-copy {
  padding: 44rpx 0;
  color: #a18a80;
  font-size: var(--tl-font-body-sm);
  text-align: center;
}
.insight-list {
  position: relative;
  margin-top: 22rpx;
  padding: 4rpx 0;
}
.insight-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 10rpx 2rpx;
  color: #5b4840;
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
  line-height: 1.55;
}
.insight-mark {
  width: 10rpx;
  height: 10rpx;
  flex: 0 0 10rpx;
  margin-top: 13rpx;
  border-radius: 50%;
  background: #ef604a;
}
/* Align the analysis controls with the records-page header. */
.analysis-page .page-content {
  padding-bottom: 24px;
}
.analysis-header {
  padding-top: 12rpx;
}
.analysis-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}
.ledger-chip,
.month-switcher {
  display: flex;
  align-items: center;
  border: 1rpx solid rgba(240, 68, 47, 0.12);
  background: rgba(255, 255, 255, 0.72);
}
.ledger-chip {
  max-width: 300rpx;
  height: 70rpx;
  padding: 0 22rpx;
  border-radius: var(--tl-radius-pill);
}
.ledger-chip tl-icon {
  flex: 0 0 auto;
  margin-left: 10rpx;
}
.ledger-name {
  overflow: hidden;
  color: var(--tl-color-text);
  font-size: var(--tl-font-body);
  font-weight: var(--tl-font-weight-bold);
  text-overflow: ellipsis;
  white-space: nowrap;
}
.month-switcher {
  height: 70rpx;
  overflow: hidden;
  border-radius: var(--tl-radius-pill);
}
.month-switcher.is-static {
  padding: 0 26rpx;
}
.month-nav {
  display: flex;
  width: 64rpx;
  height: 70rpx;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.month-nav tl-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}
.month-text {
  min-width: 160rpx;
  color: var(--tl-color-text);
  font-size: var(--tl-font-body);
  font-weight: var(--tl-font-weight-bold);
  text-align: center;
}
.analysis-filter-panel {
  margin: 0 -8rpx 24rpx;
  padding: 12rpx 8rpx 16rpx;
  background: rgba(255, 247, 242, 0.96);
}
.segmented {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
  padding: 8rpx;
  border-radius: var(--tl-radius-pill);
  background: rgba(255, 255, 255, 0.78);
}
.seg-item {
  display: flex;
  height: 64rpx;
  align-items: center;
  justify-content: center;
  border-radius: var(--tl-radius-pill);
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
}
.seg-item.active {
  background: var(--tl-color-primary);

  color: var(--tl-color-text-inverse);
}

.analysis-chart-canvas {
  display: flex;
  width: 100%;
  height: 430rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

#analysis-chart {
  display: block;
  width: 638rpx;
  height: 430rpx;
}

.analysis-scroll {
  width: 100%;
  min-height: 0;
  flex: 1 1 0;
}

:host {
  display: flex;
  width: 100%;
  min-height: 0;
  flex: 1 1 0;
  overflow: hidden;
}

.tab-panel {
  display: flex;
  width: 100%;
  min-height: 0;
  flex: 1 1 0;
  flex-direction: column;
  overflow: hidden;
}

.analysis-scroll {
  display: block;
  width: 100%;
  height: 100%;
  min-height: 0;
  flex: 1 1 0;
}

.page-content {
  width: 100%;
  min-height: 100%;
  padding-bottom: 24px;
}
