:host {
  display: flex;
  width: 100%;
  min-height: 0;
  flex: 1 1 0;
  overflow: hidden;
}

.tab-panel {
  display: flex;
  width: 100%;
  min-height: 0;
  flex: 1 1 0;
  flex-direction: column;
  overflow: hidden;
}

.analysis-scroll {
  display: block;
  width: 100%;
  height: 100%;
  min-height: 0;
  flex: 1 1 0;
}

.page-content {
  width: 100%;
  min-height: 100%;
  padding-bottom: 24px;
}

.analysis-header {
  padding-top: 12rpx;
}

.ledger-name {
  overflow: hidden;
  color: var(--tl-color-text);
  font-size: var(--tl-font-body);
  font-weight: var(--tl-font-weight-bold);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chart-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-kicker {
  color: var(--tl-color-warning);
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
  letter-spacing: 3rpx;
}

.card-title {
  color: var(--tl-color-text);
  font-size: var(--tl-font-heading);
  font-weight: var(--tl-font-weight-bold);
}

.chart-card {
  margin-top: 20rpx;
  padding: 28rpx;
}

.chart-tabs {
  display: inline-flex;
  gap: 14rpx;
  padding-right: 8rpx;
}

.chart-tab {
  flex: 0 0 auto;
  padding: 15rpx 22rpx;
  border-radius: var(--tl-radius-pill);
  background: var(--tl-color-primary-soft);
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
}

.chart-tab.is-active {
  color: var(--tl-color-text-inverse);
  background: var(--tl-color-text);
}

.chart-card {
  margin-top: 0;
}

.chart-heading {
  align-items: flex-start;
}

.analysis-chart-canvas {
  display: flex;
  width: 100%;
  height: 430rpx;
  margin-top: 18rpx;
  flex-direction: column;
}

#analysis-chart {
  display: block;
  width: 100%;
  height: 430rpx;
}

.chart-card {
  margin-top: 0;
}

.analysis-chart-canvas,
#analysis-chart {
  height: 360rpx;
}

.analysis-header {
  padding-top: 12rpx;
  margin-bottom: 24rpx;
}

.analysis-context-bar {
  display: flex;
  width: 100%;
  height: 76rpx;
  align-items: center;
  border: 1rpx solid rgba(240, 68, 47, 0.12);
  border-radius: var(--tl-radius-pill);
  background: rgba(255, 255, 255, 0.78);
}

.context-ledger,
.context-period,
.context-mode {
  display: flex;
  min-width: 0;
  height: 100%;
  align-items: center;
}

.context-ledger {
  flex: 0 1 154rpx;
  justify-content: flex-start;
  padding: 0 10rpx 0 16rpx;
}

.context-ledger .ledger-name {
  min-width: 0;
  flex: 0 1 auto;
  font-size: var(--tl-font-body-sm);
}

.context-ledger tl-icon,
.context-mode tl-icon {
  flex: 0 0 auto;
  margin-left: 4rpx;
}

.context-divider {
  width: 1rpx;
  height: 28rpx;
  flex: 0 0 1rpx;
  background: var(--tl-color-divider);
}

.context-period {
  flex: 1 1 0;
  justify-content: center;
}

.context-period.is-static {
  padding: 0 12rpx;
}

.context-period-text {
  overflow: hidden;
  color: var(--tl-color-text);
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.context-nav {
  display: flex;
  width: 40rpx;
  height: 100%;
  flex: 0 0 40rpx;
  align-items: center;
  justify-content: center;
}

.context-mode-picker {
  display: flex;
  height: 100%;
  flex: 0 0 154rpx;
  align-items: center;
}

.context-mode {
  width: auto;
  margin-left: auto;
  justify-content: flex-end;
  padding: 0 16rpx 0 8rpx;
  color: var(--tl-color-primary);
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
}

.analysis-mode-sheet {
  padding: 8rpx 28rpx 28rpx;
}

.analysis-mode-sheet__title {
  color: var(--tl-color-text);
  font-size: var(--tl-font-heading);
  font-weight: var(--tl-font-weight-bold);
}

.analysis-mode-list {
  margin-top: 20rpx;
  border-top: 1rpx solid var(--tl-color-divider);
}

.analysis-mode-option {
  display: flex;
  min-height: 100rpx;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid var(--tl-color-divider);
  color: var(--tl-color-text-secondary);
  font-size: var(--tl-font-body);
  font-weight: var(--tl-font-weight-bold);
}

.analysis-mode-option:last-child {
  border-bottom: none;
}

.analysis-mode-option.is-active {
  color: var(--tl-color-primary);
}

.calendar-card {
  margin-top: 0;
  padding: 16rpx 18rpx 18rpx;
}

.calendar-weekdays,
.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
}

.calendar-weekdays {
  margin-bottom: 8rpx;
  padding: 10rpx 2rpx;
  border-radius: var(--tl-radius-xs);
  background: var(--tl-color-surface-muted);
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
  text-align: center;
}

.calendar-cell {
  display: flex;
  min-width: 0;
  min-height: 112rpx;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 2rpx 6rpx;
  border: 1rpx solid transparent;
  border-radius: var(--tl-radius-xs);
}

.calendar-cell.is-striped {
  background: var(--tl-palette-warm-100);
}

.calendar-cell.is-active {
  border-color: var(--tl-color-primary);
  background: var(--tl-color-primary-soft);
}

.calendar-cell.is-today .calendar-day {
  color: var(--tl-color-primary);
}

.calendar-cell.is-blank {
  pointer-events: none;
}

.calendar-day {
  color: var(--tl-color-text-secondary);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
}

.calendar-money {
  display: flex;
  width: 100%;
  min-width: 0;
  flex-direction: column;
  gap: 3rpx;
  margin-top: 7rpx;
  text-align: center;
}

.calendar-income,
.calendar-expense {
  overflow: hidden;
  font-size: var(--tl-font-caption-compact);
  font-weight: var(--tl-font-weight-bold);
  letter-spacing: -0.4rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.calendar-income {
  color: var(--tl-color-income);
}

.calendar-expense {
  color: var(--tl-color-expense);
}

.calendar-record-empty {
  margin-top: 0;
  padding: 46rpx 28rpx;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-body-sm);
  text-align: center;
}

.showcase-insights {
  margin-top: 20rpx;
  padding: 28rpx;
}

.showcase-section {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 18rpx;
  margin: 38rpx 4rpx 14rpx;
}

.showcase-insight {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 15rpx 0;
  color: var(--tl-color-text-secondary);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
  line-height: 1.55;
}

.showcase-insight + .showcase-insight {
  border-top: 1rpx solid var(--tl-color-divider);
}

.insight-label {
  flex: 0 0 auto;
  padding: 5rpx 10rpx;
  border-radius: var(--tl-radius-pill);
  background: var(--tl-color-surface-muted);
  color: var(--tl-color-text-secondary);
  font-size: var(--tl-font-caption-compact);
}

.insight-label.warning {
  background: var(--tl-color-primary-soft);
  color: var(--tl-color-primary);
}

.is-income {
  color: var(--tl-color-income) !important;
}

.is-expense {
  color: var(--tl-color-expense) !important;
}

#month-category-chart,
#month-budget-chart,
#year-category-chart,
#calendar-week-chart,
#all-category-chart {
  display: block;
  width: 100%;
  height: 300rpx;
}

.analysis-summary-card {
  padding: 30rpx;
  background: var(--tl-color-primary-soft);
}

.summary-eyebrow,
.summary-metrics,
.calendar-list-head,
.calendar-day-total,
.analysis-record-row,
.category-ranking-row,
.calendar-detail-row {
  display: flex;
  align-items: center;
}

.summary-eyebrow,
.calendar-list-head {
  justify-content: space-between;
}

.summary-title {
  display: block;
  margin-top: 24rpx;
  color: var(--tl-color-text);
  font-size: var(--tl-font-heading);
  font-weight: var(--tl-font-weight-bold);
  line-height: 1.45;
}

.summary-copy {
  display: block;
  margin-top: 12rpx;
  color: var(--tl-color-text-secondary);
  font-size: var(--tl-font-body-sm);
  line-height: 1.65;
}

.summary-metrics {
  gap: 12rpx;
  margin-top: 26rpx;
}

.summary-metric {
  min-width: 0;
  flex: 1;
  padding: 18rpx 12rpx;
  border-radius: var(--tl-radius-control);
  background: rgba(255, 255, 255, 0.76);
  text-align: center;
}

.summary-metric text {
  display: block;
  overflow: hidden;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.summary-metric text:last-child {
  margin-top: 8rpx;
  color: var(--tl-color-text);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
}

.analysis-record-list,
.category-ranking,
.calendar-detail-list {
  padding: 0 28rpx;
}

.analysis-record-row,
.calendar-detail-row {
  min-height: 112rpx;
  gap: 18rpx;
  border-bottom: 1rpx solid var(--tl-color-divider);
}

.analysis-record-row:last-child,
.category-ranking-row:last-child,
.calendar-detail-row:last-child {
  border-bottom: none;
}

.category-index {
  display: flex;
  width: 40rpx;
  height: 40rpx;
  flex: 0 0 40rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--tl-color-surface-muted);
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
}

.category-main {
  min-width: 0;
  flex: 1;
}

.category-main text {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.category-main text:first-child {
  color: var(--tl-color-text);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
}

.category-main text:last-child {
  margin-top: 7rpx;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
}

.record-amount {
  flex: 0 0 auto;
  font-size: var(--tl-font-body);
  font-weight: var(--tl-font-weight-bold);
}

.category-ranking-row {
  min-height: 108rpx;
  gap: 18rpx;
  border-bottom: 1rpx solid var(--tl-color-divider);
}

.change-badge {
  flex: 0 0 auto;
  padding: 7rpx 12rpx;
  border-radius: var(--tl-radius-pill);
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
}

.change-badge.is-up {
  color: var(--tl-color-expense);
  background: var(--tl-color-primary-soft);
}

.change-badge.is-down {
  color: var(--tl-color-income);
  background: var(--tl-color-income-soft);
}

.change-badge.is-flat {
  color: var(--tl-color-text-tertiary);
  background: var(--tl-color-surface-muted);
}

.calendar-first-head {
  margin-top: 8rpx;
}

.calendar-list-head {
  gap: 18rpx;
  margin: 36rpx 4rpx 14rpx;
}

.calendar-list-head > view:first-child {
  min-width: 0;
}

.calendar-list-count {
  display: block;
  margin-top: 6rpx;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
}

.calendar-day-total {
  flex: 0 0 auto;
  gap: 14rpx;
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
}

#month-ratio-chart,
#year-cashflow-chart,
#year-balance-chart {
  display: block;
  width: 100%;
  height: 100%;
}

.analysis-summary-card .summary-title {
  font-size: var(--tl-font-data-lg);
  letter-spacing: -2rpx;
}

.analysis-summary-card .summary-metric:nth-child(3) {
  display: none;
}

.analysis-chart-switcher {
  width: 100%;
  margin: 0 0 18rpx;
  white-space: nowrap;
}

.analysis-chart-switcher .chart-tabs {
  padding-left: 4rpx;
}

.calendar-detail-row {
  align-items: flex-start;
  min-height: 132rpx;
  padding-top: 24rpx;
  padding-bottom: 24rpx;
}

.analysis-record-list,
.calendar-detail-list {
  padding: 0;
}

.analysis-record-row,
.calendar-detail-row {
  min-height: 132rpx;
  padding: 24rpx 26rpx;
  align-items: flex-start;
}

.analysis-record-row .category-mark,
.calendar-detail-row .category-mark {
  width: 78rpx;
  height: 78rpx;
  flex: 0 0 78rpx;
  margin-top: 4rpx;
  border-radius: var(--tl-radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
}

.analysis-record-row .category-mark.expense,
.calendar-detail-row .category-mark.expense {
  background: var(--tl-color-primary-soft);
}

.analysis-record-row .category-mark.income,
.calendar-detail-row .category-mark.income {
  background: var(--tl-color-income-soft);
}

.analysis-record-row .record-main,
.calendar-detail-row .record-main {
  min-width: 0;
  flex: 1;
  padding: 0 14rpx 0 20rpx;
}

.analysis-record-row .record-line,
.calendar-detail-row .record-line {
  display: flex;
  min-height: 34rpx;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.analysis-record-row .record-subline,
.calendar-detail-row .record-subline {
  margin-top: 10rpx;
}

.analysis-record-row .record-title,
.calendar-detail-row .record-title {
  min-width: 0;
  overflow: hidden;
  color: var(--tl-color-text);
  font-size: var(--tl-font-body);
  font-weight: var(--tl-font-weight-bold);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.analysis-record-row .record-meta,
.calendar-detail-row .record-meta {
  margin-top: 0;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
}

.analysis-record-row .record-note,
.calendar-detail-row .record-note {
  display: block;
  margin-top: 6rpx;
  overflow: hidden;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.analysis-record-row .record-amount,
.calendar-detail-row .record-amount {
  flex: 0 0 auto;
  font-size: var(--tl-font-body);
}

.ranking-toggle {
  display: flex;
  flex: 0 0 auto;
  padding: 4rpx;
  border-radius: var(--tl-radius-pill);
  background: var(--tl-color-surface-muted);
}

.ranking-toggle__item {
  min-width: 64rpx;
  padding: 8rpx 14rpx;
  border-radius: var(--tl-radius-pill);
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
  line-height: 1.3;
  text-align: center;
}

.ranking-toggle__item.is-active {
  background: var(--tl-color-surface);
  color: var(--tl-color-primary);
}

.section-title-with-help {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.section-help-trigger {
  display: flex;
  width: 44rpx;
  height: 44rpx;
  align-items: center;
  justify-content: center;
}

.analysis-question-dialog {
  padding: 32rpx;
}

.analysis-question-dialog__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.analysis-question-dialog__title {
  color: var(--tl-color-text);
  font-size: var(--tl-font-heading);
  font-weight: var(--tl-font-weight-bold);
}

.analysis-question-dialog__close {
  display: flex;
  width: 56rpx;
  height: 56rpx;
  flex: 0 0 56rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--tl-color-surface-muted);
}

.analysis-question-dialog__copy {
  display: block;
  margin-top: 20rpx;
  color: var(--tl-color-text-secondary);
  font-size: var(--tl-font-body);
  line-height: 1.7;
}

.analysis-ratio-list {
  margin-top: 16rpx;
  border-top: 1rpx solid var(--tl-color-divider);
}

.analysis-ratio-row {
  display: flex;
  min-height: 68rpx;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  border-bottom: 1rpx solid var(--tl-color-divider);
  color: var(--tl-color-text);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
}

.analysis-ratio-row text:last-child {
  flex: 0 0 auto;
  color: var(--tl-color-text-secondary);
  font-size: var(--tl-font-caption);
}
