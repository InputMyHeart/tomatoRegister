:host {
  display: flex;
  width: 100%;
  min-height: 0;
  flex: 1 1 0;
  overflow: hidden;
}

.tab-panel {
  display: flex;
  width: 100%;
  min-height: 0;
  flex: 1 1 0;
  flex-direction: column;
  overflow: hidden;
}

.analysis-scroll {
  display: block;
  width: 100%;
  height: 100%;
  min-height: 0;
  flex: 1 1 0;
}

.page-content {
  width: 100%;
  min-height: 100%;
  padding-bottom: 24px;
}

.analysis-header {
  padding-top: 12rpx;
}

.analysis-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.ledger-chip,
.month-switcher {
  display: flex;
  align-items: center;
  border: 1rpx solid rgba(240, 68, 47, 0.12);
  background: rgba(255, 255, 255, 0.72);
}

.ledger-chip {
  min-width: 0;
  max-width: 300rpx;
  height: 70rpx;
  padding: 0 22rpx;
  border-radius: var(--tl-radius-pill);
}

.ledger-chip tl-icon {
  flex: 0 0 auto;
  margin-left: 10rpx;
}

.ledger-name {
  overflow: hidden;
  color: var(--tl-color-text);
  font-size: var(--tl-font-body);
  font-weight: var(--tl-font-weight-bold);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.month-switcher {
  height: 70rpx;
  overflow: hidden;
  border-radius: var(--tl-radius-pill);
}

.month-switcher.is-static {
  padding: 0 26rpx;
}

.month-nav {
  display: flex;
  width: 60rpx;
  height: 70rpx;
  align-items: center;
  justify-content: center;
}

.month-text {
  min-width: 132rpx;
  color: var(--tl-color-text);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
  text-align: center;
}

.analysis-filter-panel {
  margin: 0 -8rpx 24rpx;
  padding: 12rpx 8rpx 16rpx;
  background: rgba(255, 247, 242, 0.96);
}

.segmented {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
  padding: 8rpx;
  border-radius: var(--tl-radius-pill);
  background: rgba(255, 255, 255, 0.78);
}

.seg-item {
  display: flex;
  height: 64rpx;
  align-items: center;
  justify-content: center;
  border-radius: var(--tl-radius-pill);
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
}

.seg-item.active {
  background: var(--tl-color-primary);
  color: var(--tl-color-text-inverse);
}

.overview-card {
  position: relative;
  overflow: hidden;
  padding: 32rpx;
  background: var(--tl-color-primary-soft);
}

.overview-head,
.card-heading-row,
.chart-heading,
.budget-meta,
.ranking-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.overview-kicker,
.section-kicker {
  color: #e76a53;
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
  letter-spacing: 3rpx;
}

.overview-title,
.card-title,
.section-title {
  color: var(--tl-color-text);
  font-size: var(--tl-font-heading);
  font-weight: var(--tl-font-weight-bold);
}

.overview-title {
  margin-top: 7rpx;
}

.save-badge,
.budget-state {
  padding: 12rpx 17rpx;
  border-radius: var(--tl-radius-pill);
  background: var(--tl-color-surface);
  color: var(--tl-color-primary);
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
}

.save-badge.is-negative,
.budget-state.is-over {
  color: var(--tl-color-danger);
  background: var(--tl-color-danger-soft);
}

.main-balance {
  margin-top: 32rpx;
}

.balance-label {
  display: block;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-body-sm);
}

.balance-value {
  display: inline-block;
  margin-top: 5rpx;
  color: var(--tl-color-text);
  font-size: var(--tl-font-data-lg);
  font-weight: var(--tl-font-weight-bold);
  letter-spacing: -2rpx;
}

.balance-value.is-negative {
  color: var(--tl-color-danger);
}

.balance-compare {
  margin-left: 14rpx;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
}

.money-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 27rpx;
}

.money-cell {
  min-width: 0;
  padding: 19rpx 14rpx;
  border-radius: var(--tl-radius-control);
  background: rgba(255, 255, 255, 0.76);
}

.money-cell > text {
  display: block;
  overflow: hidden;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.money-cell > text:nth-child(2) {
  margin-top: 8rpx;
  color: var(--tl-color-text);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
}

.income-cell > text:nth-child(2) {
  color: var(--tl-color-income);
}

.expense-cell > text:nth-child(2) {
  color: var(--tl-color-expense);
}

.money-cell .metric-compare {
  margin-top: 6rpx;
  color: var(--tl-color-text-tertiary);
}

.budget-card,
.chart-card,
.ranking-card,
.insight-card {
  margin-top: 20rpx;
  padding: 28rpx;
}

.budget-meta {
  margin-top: 14rpx;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
}

.quick-metrics {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
  margin-top: 20rpx;
}

.quick-metric {
  min-width: 0;
  padding: 24rpx;
}

.quick-metric text {
  display: block;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
}

.quick-metric text:last-child {
  margin-top: 10rpx;
  overflow: hidden;
  color: var(--tl-color-text);
  font-size: var(--tl-font-heading);
  font-weight: var(--tl-font-weight-bold);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.section-head {
  margin: 38rpx 4rpx 18rpx;
}

.section-title {
  margin-top: 7rpx;
}

.chart-switcher {
  width: 100%;
  margin-bottom: 18rpx;
  white-space: nowrap;
}

.chart-tabs {
  display: inline-flex;
  gap: 14rpx;
  padding-right: 8rpx;
}

.chart-tab {
  flex: 0 0 auto;
  padding: 15rpx 22rpx;
  border-radius: var(--tl-radius-pill);
  background: var(--tl-color-primary-soft);
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
}

.chart-tab.is-active {
  color: var(--tl-color-text-inverse);
  background: var(--tl-color-text);
}

.chart-card {
  margin-top: 0;
}

.chart-heading {
  align-items: flex-start;
}

.chart-subtitle {
  margin-top: 8rpx;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
}

.touch-hint {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 6rpx;
  margin-left: 14rpx;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
}

.analysis-chart-canvas {
  display: flex;
  width: 100%;
  height: 430rpx;
  margin-top: 18rpx;
  flex-direction: column;
}

#analysis-chart {
  display: block;
  width: 100%;
  height: 430rpx;
}

.empty-copy {
  padding: 68rpx 0 48rpx;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-body-sm);
  text-align: center;
}

.ranking-list {
  margin-top: 24rpx;
}

.ranking-item + .ranking-item {
  margin-top: 22rpx;
}

.ranking-main {
  gap: 12rpx;
}

.ranking-index {
  display: flex;
  width: 38rpx;
  height: 38rpx;
  flex: 0 0 38rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--tl-color-primary-soft);
  color: var(--tl-color-primary);
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
}

.ranking-name {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: var(--tl-color-text-secondary);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ranking-rate {
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
}

.ranking-amount {
  color: var(--tl-color-text);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
}

.ranking-track {
  height: 10rpx;
  margin: 10rpx 0 0 50rpx;
  overflow: hidden;
  border-radius: var(--tl-radius-pill);
  background: var(--tl-color-primary-soft);
}

.ranking-bar {
  height: 100%;
  border-radius: inherit;
  background: var(--tl-color-primary);
}

.insight-list {
  margin-top: 20rpx;
}

.insight-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 10rpx 2rpx;
  color: var(--tl-color-text-secondary);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
  line-height: 1.55;
}

.insight-mark {
  width: 10rpx;
  height: 10rpx;
  flex: 0 0 10rpx;
  margin-top: 13rpx;
  border-radius: 50%;
  background: var(--tl-color-primary);
}

/* Analysis filters use horizontal scroll so five range modes remain readable. */
.analysis-filter-panel {
  width: 100%;
  margin: 0 0 20rpx;
  padding: 0;
  background: transparent;
  white-space: nowrap;
}

.segmented {
  display: inline-flex;
  min-width: 100%;
  gap: 8rpx;
}

.seg-item {
  min-width: 110rpx;
}

.custom-range {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  margin: -8rpx 0 20rpx;
  padding: 12rpx 20rpx;
  border: 1rpx solid rgba(240, 68, 47, 0.12);
  border-radius: var(--tl-radius-control);
  background: rgba(255, 255, 255, 0.72);
}

.custom-date-picker {
  display: flex;
  gap: 8rpx;
  color: var(--tl-color-text);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
}

.custom-date-label,
.custom-range-divider {
  color: var(--tl-color-text-tertiary);
  font-weight: var(--tl-font-weight-regular);
}

.insight-card {
  margin-top: 0;
}

.insight-group + .insight-group {
  margin-top: 12rpx;
}

.insight-group-title {
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
}

.insight-group-up .insight-group-title {
  color: var(--tl-color-income);
}

.insight-group-up .insight-mark {
  background: var(--tl-color-income);
}

.insight-group-down .insight-group-title {
  color: var(--tl-color-expense);
}

.insight-group-down .insight-mark {
  background: var(--tl-color-expense);
}

.section-head {
  margin-top: 28rpx;
}

.chart-card {
  margin-top: 0;
}

.analysis-chart-canvas,
#analysis-chart {
  height: 360rpx;
}

.data-panel {
  height: 360rpx;
  margin-top: 20rpx;
  padding: 28rpx;
}

.data-panel-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.data-panel-count {
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
}

.data-panel-scroll {
  height: 250rpx;
  margin-top: 18rpx;
}

.trend-data-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 0 0 14rpx;
  border-bottom: 1rpx solid var(--tl-color-divider);
}

.trend-data-item + .trend-data-item {
  margin-top: 16rpx;
}

.trend-data-label {
  flex: 0 0 auto;
  color: var(--tl-color-text-secondary);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
}

.trend-data-values {
  display: flex;
  gap: 12rpx;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
}

/* Compact analysis context: ledger, period, and range mode share one control bar. */
.analysis-header {
  padding-top: 12rpx;
  margin-bottom: 24rpx;
}

.analysis-context-bar {
  display: flex;
  width: 100%;
  height: 76rpx;
  align-items: center;
  border: 1rpx solid rgba(240, 68, 47, 0.12);
  border-radius: var(--tl-radius-pill);
  background: rgba(255, 255, 255, 0.78);
}

.context-ledger,
.context-period,
.context-mode {
  display: flex;
  min-width: 0;
  height: 100%;
  align-items: center;
}

.context-ledger {
  flex: 0 1 154rpx;
  justify-content: flex-start;
  padding: 0 10rpx 0 16rpx;
}

.context-ledger .ledger-name {
  min-width: 0;
  flex: 0 1 auto;
  font-size: var(--tl-font-body-sm);
}

.context-ledger tl-icon,
.context-mode tl-icon {
  flex: 0 0 auto;
  margin-left: 4rpx;
}

.context-divider {
  width: 1rpx;
  height: 28rpx;
  flex: 0 0 1rpx;
  background: var(--tl-color-divider);
}

.context-period {
  flex: 1 1 0;
  justify-content: center;
}

.context-period.is-static {
  padding: 0 12rpx;
}

.context-period-text {
  overflow: hidden;
  color: var(--tl-color-text);
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.context-nav {
  display: flex;
  width: 40rpx;
  height: 100%;
  flex: 0 0 40rpx;
  align-items: center;
  justify-content: center;
}

.context-mode-picker {
  display: flex;
  height: 100%;
  flex: 0 0 154rpx;
  align-items: center;
}

.context-mode {
  width: auto;
  margin-left: auto;
  justify-content: flex-end;
  padding: 0 16rpx 0 8rpx;
  color: var(--tl-color-primary);
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
}

.analysis-filter-panel {
  display: none;
}

.custom-range {
  margin: 14rpx 0 4rpx;
}

.analysis-mode-sheet {
  padding: 8rpx 28rpx 28rpx;
}

.analysis-mode-sheet__title {
  color: var(--tl-color-text);
  font-size: var(--tl-font-heading);
  font-weight: var(--tl-font-weight-bold);
}

.analysis-mode-list {
  margin-top: 20rpx;
  border-top: 1rpx solid var(--tl-color-divider);
}

.analysis-mode-option {
  display: flex;
  min-height: 100rpx;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid var(--tl-color-divider);
  color: var(--tl-color-text-secondary);
  font-size: var(--tl-font-body);
  font-weight: var(--tl-font-weight-bold);
}

.analysis-mode-option:last-child {
  border-bottom: none;
}

.analysis-mode-option.is-active {
  color: var(--tl-color-primary);
}

.calendar-card {
  margin-top: 0;
  padding: 16rpx 18rpx 18rpx;
}

.calendar-weekdays,
.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
}

.calendar-weekdays {
  margin-bottom: 8rpx;
  padding: 10rpx 2rpx;
  border-radius: var(--tl-radius-xs);
  background: var(--tl-color-surface-muted);
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
  text-align: center;
}

.calendar-cell {
  display: flex;
  min-width: 0;
  min-height: 112rpx;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 2rpx 6rpx;
  border: 1rpx solid transparent;
  border-radius: var(--tl-radius-xs);
}

.calendar-cell.is-striped {
  background: #fff8f4;
}

.calendar-cell.is-active {
  border-color: var(--tl-color-primary);
  background: var(--tl-color-primary-soft);
}

.calendar-cell.is-today .calendar-day {
  color: var(--tl-color-primary);
}

.calendar-cell.is-blank {
  pointer-events: none;
}

.calendar-day {
  color: var(--tl-color-text-secondary);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
}

.calendar-money {
  display: flex;
  width: 100%;
  min-width: 0;
  flex-direction: column;
  gap: 3rpx;
  margin-top: 7rpx;
  text-align: center;
}

.calendar-income,
.calendar-expense {
  overflow: hidden;
  font-size: var(--tl-font-caption-compact);
  font-weight: var(--tl-font-weight-bold);
  letter-spacing: -0.4rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.calendar-income {
  color: var(--tl-color-income);
}

.calendar-expense {
  color: var(--tl-color-expense);
}

.calendar-records-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 30rpx 4rpx 14rpx;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
}

.calendar-records {
  margin-top: 0;
  padding: 0 28rpx;
}

.calendar-record-row {
  display: flex;
  min-height: 104rpx;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  border-bottom: 1rpx solid var(--tl-color-divider);
}

.calendar-record-row:last-child {
  border-bottom: none;
}

.calendar-record-main {
  min-width: 0;
  flex: 1 1 auto;
}

.calendar-record-category,
.calendar-record-meta {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.calendar-record-category {
  color: var(--tl-color-text);
  font-size: var(--tl-font-body);
  font-weight: var(--tl-font-weight-bold);
}

.calendar-record-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 7rpx;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
}

.calendar-record-account {
  color: var(--tl-color-text-tertiary);
}

.calendar-record-amount {
  flex: 0 0 auto;
  font-size: var(--tl-font-body);
  font-weight: var(--tl-font-weight-bold);
}

.calendar-record-amount.income {
  color: var(--tl-color-income);
}

.calendar-record-amount.expense {
  color: var(--tl-color-expense);
}

.calendar-record-empty {
  margin-top: 0;
  padding: 46rpx 28rpx;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-body-sm);
  text-align: center;
}

/* Product-review analysis showcase */
.showcase-status,
.showcase-overview,
.showcase-calendar-summary,
.showcase-insights,
.showcase-list,
.showcase-performance,
.showcase-filters {
  margin-top: 20rpx;
  padding: 28rpx;
}

.showcase-status {
  background: var(--tl-color-primary-soft);
}

.showcase-status__head,
.showcase-overview__grid,
.showcase-rank__line,
.showcase-change,
.showcase-budget,
.showcase-record,
.showcase-filters {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.showcase-status__tag {
  padding: 8rpx 14rpx;
  border-radius: var(--tl-radius-pill);
  background: var(--tl-color-surface);
  color: var(--tl-color-primary);
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
}

.showcase-status__title {
  display: block;
  margin-top: 20rpx;
  color: var(--tl-color-text);
  font-size: var(--tl-font-heading);
  font-weight: var(--tl-font-weight-bold);
}

.showcase-status__text,
.showcase-overview__compare,
.showcase-section__note {
  display: block;
  margin-top: 8rpx;
  color: var(--tl-color-text-secondary);
  font-size: var(--tl-font-body-sm);
  line-height: var(--tl-line-height-normal);
}

.showcase-overview__value {
  display: block;
  margin-top: 10rpx;
  color: var(--tl-color-text);
  font-size: var(--tl-font-data-lg);
  font-weight: var(--tl-font-weight-bold);
  letter-spacing: -2rpx;
}

.showcase-overview__grid {
  gap: 16rpx;
  margin-top: 24rpx;
}

.showcase-overview__grid view {
  min-width: 0;
  flex: 1;
  padding: 18rpx;
  border-radius: var(--tl-radius-control);
  background: var(--tl-color-surface-muted);
}

.showcase-overview__grid text,
