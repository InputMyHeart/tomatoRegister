  font-size: var(--tl-font-caption-compact);
  text-align: center;
}

.showcase-mini-plot text::before {
  position: absolute;
  right: 7rpx;
  bottom: 28rpx;
  left: 7rpx;
  height: 90rpx;
  border-radius: var(--tl-radius-xs) var(--tl-radius-xs) 0 0;
  background: var(--tl-color-primary);
  content: "";
}

.showcase-mini-plot text:nth-child(2)::before {
  height: 54rpx;
}
.showcase-mini-plot text:nth-child(3)::before {
  height: 70rpx;
}
.showcase-mini-plot text:nth-child(4)::before {
  height: 48rpx;
}
.showcase-mini-plot text:nth-child(5)::before {
  height: 108rpx;
}
.showcase-mini-plot text:nth-child(6)::before {
  height: 142rpx;
}
.showcase-mini-plot text:nth-child(7)::before {
  height: 78rpx;
}
.showcase-mini-plot text:nth-child(8)::before {
  height: 96rpx;
}

.is-income {
