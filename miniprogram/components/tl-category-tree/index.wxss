:host {
  --tl-category-radius-card: 34rpx;
  --tl-category-radius-control: 20rpx;
  --tl-category-radius-item: 28rpx;
  --tl-category-primary: var(--tl-color-primary);
  --tl-category-primary-soft: var(--tl-color-primary-soft);
  --tl-category-surface: var(--tl-color-surface);
  --tl-category-text: #312522;
  --tl-category-text-tertiary: #9a8278;
  --tl-category-font: 28rpx;
  --tl-category-caption: 22rpx;
  --tl-category-font-weight: 700;
}

.tl-category-tree__group {
  margin-top: 24rpx;
  margin-bottom: 18rpx;
  overflow: hidden;
  border: 1rpx solid rgba(240, 68, 47, 0.08);
  border-radius: var(--tl-category-radius-card);
  background: var(--tl-category-surface);
}
.tl-category-tree__parent {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx;
  color: var(--tl-category-text-tertiary);
}
.tl-category-tree__parent-icon,
.tl-category-tree__child-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}
.tl-category-tree__parent-icon {
  width: 70rpx;
  height: 70rpx;
  flex: 0 0 70rpx;
  border-radius: var(--tl-category-radius-control);
  color: var(--tl-category-primary);
  background: var(--tl-category-primary-soft);
}
.tl-category-tree__parent-name {
  flex: 1;
  color: var(--tl-category-text);
  font-size: var(--tl-category-font);
  font-weight: var(--tl-category-font-weight);
}
.tl-category-tree__children {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  column-gap: 12rpx;
  row-gap: 16rpx;
  margin: 0 24rpx;
  padding: 22rpx 0 24rpx;
  border-top: 1rpx solid var(--tl-color-divider-warm);
}
.tl-category-tree__child {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  width: 100%;
  height: 140rpx;
  min-width: 0;
  padding: 12rpx 6rpx;
  box-sizing: border-box;
  overflow: hidden;
  border-radius: var(--tl-category-radius-item);
  color: var(--tl-category-text);
  font-size: var(--tl-category-caption);
  font-weight: var(--tl-category-font-weight);
  line-height: 1.15;
  text-align: center;
  background: var(--tl-palette-warm-100);
}
.tl-category-tree__child-icon {
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 48rpx;
  border-radius: var(--tl-category-radius-control);
  color: var(--tl-category-primary);
  background: var(--tl-category-primary-soft);
}
