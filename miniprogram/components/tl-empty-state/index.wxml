<view wx:if="{{show}}" class="tl-empty-state tl-empty-state--{{variant}}">
  <image class="tl-empty-state__icon" src="/images/brand/tomato-ledger-logo-256-transparent.png" mode="aspectFit">
  </image>
  <view class="tl-empty-state__title">{{title || text}}</view>
  <view wx:if="{{description}}" class="tl-empty-state__description">{{description}}</view>
  <view class="tl-empty-state__actions">
    <slot />
  </view>
</view>
