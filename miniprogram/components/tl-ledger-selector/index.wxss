.tl-ledger-selector {
  max-height: 46vh;
  padding: 0 2rpx;
}
.tl-ledger-selector__item {
  display: flex;
  align-items: center;
  min-height: var(--tl-list-row-height);
  gap: 20rpx;
  margin-bottom: 16rpx;
  padding: 20rpx 22rpx;
  border: 2rpx solid var(--tl-color-divider);
  border-radius: var(--tl-radius-control);
  background: var(--tl-color-surface);
}
.tl-ledger-selector__item.is-current {
  border-color: #f0442f;
  background: #fff2ee;
}
.tl-ledger-selector__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 66rpx;
  height: 66rpx;
  flex: 0 0 66rpx;
  border-radius: var(--tl-radius-control);
  color: var(--tl-color-primary);
  background: var(--tl-color-primary-soft);
}
.tl-ledger-selector__content {
  flex: 1;
  min-width: 0;
}
.tl-ledger-selector__title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.tl-ledger-selector__name {
  flex: 1;
  overflow: hidden;
  color: var(--tl-color-text);
  font-size: var(--tl-font-body);
  font-weight: var(--tl-font-weight-bold);
  text-overflow: ellipsis;
  white-space: nowrap;
}
.tl-ledger-selector__tag {
  display: flex;
  align-items: center;
  height: 34rpx;
  box-sizing: border-box;
  align-self: center;
  flex: 0 0 auto;
  padding: 6rpx 14rpx;
  border-radius: var(--tl-radius-pill);
  color: var(--tl-color-primary);
  font-size: var(--tl-font-caption);
  background: rgba(240, 68, 47, 0.1);
}
.tl-ledger-selector__meta {
  display: block;
  margin-top: 8rpx;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
}
