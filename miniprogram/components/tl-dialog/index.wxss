.tl-dialog {
  position: fixed;
  inset: 0;
  z-index: var(--tl-z-overlay);
  padding: env(safe-area-inset-top) var(--tl-space-xl) env(safe-area-inset-bottom);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--tl-color-mask);
  animation: tl-dialog-fade var(--tl-duration-fast) var(--tl-easing-standard) both;
}

.tl-dialog__panel {
  width: 100%;
  max-height: 80vh;
  overflow: auto;
  border: var(--tl-border-width) solid var(--tl-color-border);
  border-radius: var(--tl-radius-card);
  box-sizing: border-box;
  background: var(--tl-color-surface);
}

@keyframes tl-dialog-fade {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
